# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/meddicom_db

# Server Configuration
UPLOAD_STORAGE_PATH=./storage

# AI Configuration
# 啟動時預載 AI 模型（消除第一個 /ai/segment 冷啟）。只在這次啟動要跑 AI 時設 true；
# 需先裝 requirements-ai.txt + model weights（README Step 7）。缺相依不致命（降級略過）。預設 false。
AI_WARMUP_ON_STARTUP=false
